<!DOCTYPE html>
<html lang={assigns[:page_language] || "it"} class="scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="description" content={assigns[:meta_description] || default_description()} />
    <meta name="robots" content={assigns[:robots] || "index,follow,max-image-preview:large"} />
    <meta name="theme-color" content="#050506" />
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />

    <title>{document_title(assigns[:page_title])}</title>
    <link rel="canonical" href={assigns[:canonical_url] || ExBlog.Config.canonical_url()} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="ExBlog RSS"
      href={ExBlog.Config.canonical_url() <> "/feed.xml"}
    />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="ExBlog Atom"
      href={ExBlog.Config.canonical_url() <> "/atom.xml"}
    />
    <link
      :for={translation <- assigns[:translations] || []}
      rel="alternate"
      hreflang={translation.lang}
      href={ExBlog.Config.canonical_url() <> "/#{translation.lang}/#{translation.slug}"}
    />

    <meta property="og:site_name" content={Layouts.site_name()} />
    <meta property="og:type" content={assigns[:og_type] || "website"} />
    <meta property="og:title" content={document_title(assigns[:page_title])} />
    <meta property="og:description" content={assigns[:meta_description] || default_description()} />
    <meta property="og:url" content={assigns[:canonical_url] || ExBlog.Config.canonical_url()} />
    <meta :if={assigns[:og_image]} property="og:image" content={assigns[:og_image]} />
    <meta
      :if={assigns[:og_image]}
      property="og:image:alt"
      content={assigns[:og_image_alt] || assigns[:page_title] || Layouts.site_name()}
    />
    <meta
      :if={assigns[:article] && assigns[:article].date}
      property="article:published_time"
      content={Date.to_iso8601(assigns[:article].date)}
    />
    <meta
      :if={assigns[:article] && assigns[:article].updated}
      property="article:modified_time"
      content={Date.to_iso8601(assigns[:article].updated)}
    />

    <meta
      name="twitter:card"
      content={if(assigns[:og_image], do: "summary_large_image", else: "summary")}
    />
    <meta name="twitter:title" content={document_title(assigns[:page_title])} />
    <meta
      name="twitter:description"
      content={assigns[:meta_description] || default_description()}
    />
    <meta :if={assigns[:og_image]} name="twitter:image" content={assigns[:og_image]} />

    <script :if={assigns[:json_ld]} type="application/ld+json">
      <%= encoded_json_ld(assigns[:json_ld]) %>
    </script>

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-screen bg-[color:var(--page-bg)] font-mono text-[color:var(--fg)] antialiased">
    {@inner_content}
  </body>
</html>

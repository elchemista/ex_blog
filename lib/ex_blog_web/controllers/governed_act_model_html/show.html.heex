<Layouts.app
  flash={@flash}
  current_language={@current_language}
  supported_languages={@supported_languages}
  language_paths={@language_paths}
  active_nav={:manifesto}
>
  <div
    id="governed-act-model"
    data-manifesto-language={@current_language}
    class={["pb-24"]}
  >
    <section class={["mx-auto w-full max-w-6xl px-4 pt-8 sm:px-6 lg:px-8"]}>
      <nav
        id="manifesto-breadcrumbs"
        aria-label="Breadcrumb"
        class={["flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[0.72rem] t-faint"]}
      >
        <span aria-hidden="true">$ cd</span>
        <.link href={~p"/#{@current_language}"} class={["transition hover:t-strong"]}>
          ~/{@current_language}
        </.link>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class={["t-dim"]}>governed-act-model</span>
      </nav>

      <header class={["term-window mt-4 overflow-hidden"]}>
        <div class={["term-bar"]}>
          <span class={["term-dots"]} aria-hidden="true">
            <span class={["term-dot"]}></span>
            <span class={["term-dot"]}></span>
            <span class={["term-dot"]}></span>
          </span>
          <span class={["term-title"]}>{@manifesto.file}</span>
          <span class={["ml-auto hidden flex-none t-faint sm:block"]}>
            {@manifesto.status} · read-only
          </span>
        </div>

        <div class={["term-body p-5 sm:p-9"]}>
          <div class={["grid gap-9 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end"]}>
            <div>
              <p class={["term-prompt text-[0.7rem] uppercase tracking-[0.14em] t-faint"]}>
                {@manifesto.eyebrow}
              </p>
              <h1
                id="governed-act-title"
                class={[
                  "mt-4 max-w-4xl text-3xl font-bold leading-[1.06] tracking-[-0.04em] text-balance t-strong sm:text-5xl lg:text-[4.2rem]"
                ]}
              >
                {@manifesto.title}
              </h1>
              <p
                id="governed-act-thesis"
                class={[
                  "mt-7 max-w-3xl border-l-2 border-[color:var(--line-strong)] pl-5 text-base font-semibold leading-8 t-body sm:text-xl sm:leading-9"
                ]}
              >
                {@manifesto.thesis}
              </p>
              <p class={["mt-5 max-w-2xl text-[0.8rem] leading-6 t-dim"]}>
                <span class={["t-faint"]} aria-hidden="true">// </span>{@manifesto.summary}
              </p>
            </div>

            <div
              id="governed-act-sequence"
              class={["border border-[color:var(--line)] bg-[color:var(--surface-bar)] p-4"]}
              aria-label={@manifesto.home_note}
            >
              <p class={["text-[0.64rem] uppercase tracking-[0.16em] t-faint"]}>
                governed_surface
              </p>
              <ol class={["mt-4 space-y-2 text-[0.7rem]"]}>
                <li
                  :for={{step, index} <- Enum.with_index(@manifesto.flow, 1)}
                  class={["flex items-center gap-3"]}
                >
                  <span class={["w-5 shrink-0 t-faint"]}>{String.pad_leading("#{index}", 2, "0")}</span>
                  <span class={[
                    "min-w-0 flex-1 border-b border-dashed border-[color:var(--line)] pb-2 t-strong"
                  ]}>
                    {step}
                  </span>
                  <span
                    :if={index < length(@manifesto.flow)}
                    class={["t-faint"]}
                    aria-hidden="true"
                  >
                    ↓
                  </span>
                </li>
              </ol>
            </div>
          </div>

          <dl
            id="manifesto-metadata"
            class={[
              "mt-9 grid gap-3 border-t border-dashed border-[color:var(--line)] pt-5 text-[0.68rem] sm:grid-cols-4"
            ]}
          >
            <div>
              <dt class={["t-faint"]}>{@manifesto.source_label}</dt>
              <dd class={["mt-1 truncate t-strong"]}>{@manifesto.file}</dd>
            </div>
            <div>
              <dt class={["t-faint"]}>{@manifesto.language_label}</dt>
              <dd class={["mt-1 t-strong"]}>{@manifesto.language}</dd>
            </div>
            <div>
              <dt class={["t-faint"]}>{@manifesto.words_label}</dt>
              <dd class={["mt-1 t-strong"]}>{@manifesto.words}</dd>
            </div>
            <div>
              <dt class={["t-faint"]}>{@manifesto.reading_label}</dt>
              <dd class={["mt-1 t-strong"]}>
                {@manifesto.reading_minutes} {@manifesto.minutes_label}
              </dd>
            </div>
          </dl>
        </div>
      </header>

      <section id="manifesto-primitives" class={["mt-8"]}>
        <div class={["flex flex-wrap items-end justify-between gap-4 pb-4"]}>
          <div>
            <p class={["term-prompt text-[0.7rem] t-faint"]}>inspect forms --arity 4</p>
            <h2 class={["mt-2 text-xl font-bold tracking-tight t-strong sm:text-2xl"]}>
              {@manifesto.primitives_label}
            </h2>
          </div>
          <p class={["max-w-xl text-[0.72rem] leading-5 t-faint"]}>
            {@manifesto.primitives_summary}
          </p>
        </div>

        <div class={[
          "grid gap-px overflow-hidden border border-[color:var(--line)] bg-[color:var(--line)] sm:grid-cols-2 lg:grid-cols-4"
        ]}>
          <article
            :for={{term, index} <- Enum.with_index(@manifesto.terms, 1)}
            id={"manifesto-term-#{String.downcase(term.name)}"}
            class={[
              "group bg-[color:var(--surface)] p-5 transition hover:bg-[color:var(--surface-raised)]"
            ]}
          >
            <p class={["text-[0.64rem] tracking-[0.14em] t-faint"]}>
              {String.pad_leading("#{index}", 2, "0")} / {term.verb}
            </p>
            <h3 class={["mt-4 text-base font-bold t-strong"]}>{term.name}</h3>
            <p class={["mt-3 text-[0.72rem] leading-6 t-dim"]}>{term.description}</p>
          </article>
        </div>
      </section>
    </section>

    <section
      id="manifesto-document"
      class={[
        "mx-auto mt-14 grid w-full max-w-6xl items-start gap-10 px-4 sm:px-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:px-8"
      ]}
    >
      <aside id="manifesto-toc" class={["term-window overflow-hidden lg:sticky lg:top-20"]}>
        <div class={["term-bar"]}>
          <span class={["term-title"]}>index</span>
          <span class={["ml-auto t-faint"]}>04 laws</span>
        </div>
        <nav aria-label={@manifesto.toc_label} class={["p-4"]}>
          <p class={["mb-3 text-[0.64rem] uppercase tracking-[0.12em] t-faint"]}>
            {@manifesto.toc_label}
          </p>
          <ol class={["space-y-1 text-[0.7rem]"]}>
            <li>
              <a
                href="#manifesto-foundation"
                class={[
                  "block border-l border-[color:var(--line)] py-1.5 pl-3 leading-5 t-dim transition hover:border-[color:var(--line-strong)] hover:t-strong"
                ]}
              >
                <span class={["mr-2 t-faint"]}>00</span>{@manifesto.introduction_label}
              </a>
            </li>
            <li :for={{section, index} <- Enum.with_index(@manifesto.sections, 1)}>
              <a
                href={"##{section.id}"}
                class={[
                  "block border-l border-[color:var(--line)] py-1.5 pl-3 leading-5 t-dim transition hover:border-[color:var(--line-strong)] hover:t-strong"
                ]}
              >
                <span class={["mr-2 t-faint"]}>{String.pad_leading("#{index}", 2, "0")}</span>{section.title}
              </a>
            </li>
          </ol>
        </nav>
      </aside>

      <article id="manifesto-foundation" class={["min-w-0 scroll-mt-24"]}>
        <div class={["mb-7 flex items-center gap-4 border-b border-[color:var(--line)] pb-4"]}>
          <div class={["min-w-0"]}>
            <p class={["term-prompt text-[0.7rem] t-faint"]}>cat {@manifesto.file}</p>
            <h2 class={["mt-2 text-xl font-bold tracking-tight t-strong"]}>
              {@manifesto.document_label}
            </h2>
          </div>
          <span class={["ml-auto shrink-0 term-chip"]}>v1 · immutable history</span>
        </div>
        <div id="manifesto-body" class={["article-prose manifesto-prose"]}>
          {raw(@manifesto.html)}
        </div>
      </article>
    </section>
  </div>
</Layouts.app>

<Layouts.app
  flash={@flash}
  current_language={@current_language}
  supported_languages={@supported_languages}
  language_paths={@language_paths}
  active_nav={:docs}
>
  <div id="spectre-documentation" data-version={@version} class="pb-20">
    <div class="mx-auto max-w-[92rem] px-4 pt-7 sm:px-6 lg:px-8">
      <nav
        id="docs-breadcrumbs"
        aria-label="Breadcrumb"
        class="flex flex-wrap items-center gap-2 text-[0.72rem] t-faint"
      >
        <span aria-hidden="true">$ cd</span>
        <.link href={~p"/#{@current_language}"} class="hover:t-strong">~/{@current_language}</.link>
        <span aria-hidden="true">/</span>
        <.link href={~p"/#{@current_language}/docs"} class="hover:t-strong">docs</.link>
        <span :if={@document} aria-current="page">/ {@document.slug}</span>
        <span class="ml-auto border border-[color:var(--line)] px-2 py-1">{@copy.edition} {@version}</span>
      </nav>

      <details
        id="docs-mobile-navigation"
        class="mt-5 border border-[color:var(--line)] bg-[color:var(--surface-bar)] lg:hidden"
      >
        <summary class="cursor-pointer px-4 py-3 text-[0.75rem] t-strong">
          {@copy.chapters}
        </summary>
        <nav aria-label={@copy.chapters} class="border-t border-[color:var(--line)] p-3">
          <.chapter_navigation
            chapters={@chapters}
            language={@current_language}
            current={@document && @document.slug}
            prefix="docs-mobile"
          />
        </nav>
      </details>

      <div class="mt-7 grid min-w-0 gap-8 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_12rem]">
        <aside id="docs-sidebar" class="hidden lg:block">
          <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pr-2">
            <.link
              href={~p"/#{@current_language}/docs"}
              class="block pb-4 text-[0.7rem] font-semibold uppercase tracking-widest t-faint"
            >{@copy.chapters}</.link>
            <nav aria-label={@copy.chapters}>
              <.chapter_navigation
                chapters={@chapters}
                language={@current_language}
                current={@document && @document.slug}
                prefix="docs-desktop"
              />
            </nav>
          </div>
        </aside>

        <article id="docs-page" class="min-w-0">
          <header class="term-window overflow-hidden">
            <div class="term-bar">
              <span class="term-dots" aria-hidden="true"><span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span></span>
              <span class="term-title">docs/{if @document, do: @document.slug, else: "README"}.md</span>
            </div>
            <div class="term-body p-5 sm:p-8">
              <p class="term-prompt text-[0.7rem] t-faint">
                Spectre {@version} / Elixir · OTP · GAM
              </p>
              <h1
                id="docs-title"
                class="mt-4 break-words text-3xl font-bold leading-tight tracking-tight text-balance t-strong sm:text-4xl"
              >
                {if @document, do: @document.title, else: @copy.title}
              </h1>
              <p :if={!@document} class="mt-5 max-w-3xl text-[0.85rem] leading-7 t-dim">
                {@copy.summary}
              </p>
            </div>
          </header>

          <%= if @document do %>
            <div id="docs-body" class="article-prose mt-8 min-w-0 break-words">
              {raw(@document.html)}
            </div>
            <footer class="mt-12 border-t border-[color:var(--line)] pt-6">
              <nav
                id="docs-pagination"
                aria-label={@copy.chapters}
                class="grid gap-4 sm:grid-cols-2"
              >
                <.link
                  :if={@previous_chapter}
                  href={~p"/#{@current_language}/docs/#{@previous_chapter.slug}"}
                  class="term-window p-4 transition hover:t-strong"
                >
                  <span class="block text-[0.65rem] t-faint">← {@copy.previous}</span>
                  <span class="mt-2 block text-[0.8rem] t-strong">{@previous_chapter.title}</span>
                </.link>
                <.link
                  :if={@next_chapter}
                  href={~p"/#{@current_language}/docs/#{@next_chapter.slug}"}
                  class="term-window p-4 transition hover:t-strong"
                >
                  <span class="block text-[0.65rem] t-faint">{@copy.next} →</span>
                  <span class="mt-2 block text-[0.8rem] t-strong">{@next_chapter.title}</span>
                </.link>
              </nav>
              <a
                id="docs-source-link"
                href={"https://github.com/elchemista/ex_blog/blob/master/#{@document.file}"}
                class="mt-6 inline-block text-[0.7rem] t-faint underline decoration-dashed underline-offset-4"
              >{@copy.source} ↗</a>
            </footer>
          <% else %>
            <section id="docs-catalogue" class="mt-8">
              <h2 class="text-xl font-semibold tracking-tight t-strong">{@copy.introduction}</h2>
              <p class="mt-3 text-[0.8rem] leading-6 t-dim">{@copy.note}</p>
              <ol class="mt-6 grid gap-4 sm:grid-cols-2">
                <li :for={{chapter, index} <- Enum.with_index(@chapters, 1)} class="min-w-0">
                  <.link
                    id={"docs-card-#{chapter.slug}"}
                    href={~p"/#{@current_language}/docs/#{chapter.slug}"}
                    class="term-window block h-full p-5 transition hover:t-strong"
                  >
                    <span class="text-[0.65rem] t-faint">{String.pad_leading("#{index}", 2, "0")} / {chapter.slug}</span>
                    <h3 class="mt-3 text-base font-semibold leading-6 t-strong">
                      {chapter.title}
                    </h3>
                    <p class="mt-3 text-[0.75rem] leading-6 t-dim">{chapter.description}</p>
                  </.link>
                </li>
              </ol>
            </section>
          <% end %>
        </article>

        <aside id="docs-toc" class="hidden xl:block">
          <nav
            :if={@document && @document.sections != []}
            aria-label={@copy.contents}
            class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto"
          >
            <p class="pb-3 text-[0.65rem] font-semibold uppercase tracking-widest t-faint">
              {@copy.contents}
            </p>
            <ol class="space-y-3 border-l border-[color:var(--line)] pl-3 text-[0.7rem] leading-5 t-dim">
              <li :for={section <- @document.sections}>
                <a href={"##{section.id}"} class="transition hover:t-strong">{section.title}</a>
              </li>
            </ol>
          </nav>
        </aside>
      </div>
    </div>
  </div>
</Layouts.app>

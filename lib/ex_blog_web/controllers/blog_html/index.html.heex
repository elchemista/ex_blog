<Layouts.app
  flash={@flash}
  current_language={@current_language}
  supported_languages={@supported_languages}
>
  <section id="blog-index" class="mx-auto w-full max-w-6xl px-4 pb-20 pt-8 sm:px-6 lg:px-8">
    <div class="term-window overflow-hidden">
      <div class="term-bar">
        <span class="term-dots" aria-hidden="true">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
        </span>
        <span class="term-title">spectre — zsh — {@current_language}</span>
        <span class="ml-auto hidden flex-none t-faint sm:block">132×40</span>
      </div>

      <div class="term-body p-5 sm:p-9">
        <p class="term-prompt text-[0.78rem] t-dim">whoami</p>
        <p class="term-out mt-1 text-[0.78rem] t-body">
          {gettext("Spectre — OTP-native agent runtime for Elixir. This site runs on it.")}
        </p>

        <p class="term-prompt mt-6 text-[0.78rem] t-dim">cat manifesto.md</p>
        <h1 class="mt-4 max-w-3xl text-3xl font-bold leading-[1.12] tracking-tight text-balance t-strong sm:text-5xl lg:text-[3.4rem]">
          {raw(
            gettext("Agents that read like a %{highlight}, not a magic trick.",
              highlight: highlight(gettext("map"))
            )
          )}
        </h1>
        <p class="mt-5 max-w-2xl text-[0.85rem] leading-7 t-dim sm:text-[0.92rem]">
          <span class="t-faint" aria-hidden="true">// </span>{gettext(
            "The articles below were written over Telegram by an agent that asks before it writes. Here is how it works, and what it is built on."
          )}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-dashed border-[color:var(--line)] pt-5 text-[0.72rem] t-faint">
          <span class="term-prompt t-dim">ls -1 posts/ | wc -l</span>
          <span class="term-out t-body">{length(@articles)}</span>
          <a
            href={blog_repo_url()}
            rel="noopener noreferrer"
            class="ml-auto flex items-center gap-2 transition hover:t-strong"
          >
            github.com/{blog_repo()} <span aria-hidden="true">→</span>
          </a>
        </div>

        <p class="mt-6 text-[0.78rem] t-dim">
          <span class="t-faint">$</span> <.cursor />
        </p>
      </div>
    </div>

    <.spectre_showcase :if={is_nil(@filter)} />

    <div
      :if={@filter}
      id="active-filter"
      class="term-window mt-6 flex flex-wrap items-center justify-between gap-4 px-4 py-3 text-[0.75rem]"
    >
      <p class="term-prompt t-dim">
        grep --{if(@filter.kind == :tag, do: gettext("tag"), else: gettext("category"))}
        <span class="t-strong">"{@filter.value}"</span> posts/
      </p>
      <.link
        href={~p"/#{@current_language}"}
        class="relative z-10 t-faint transition hover:t-strong"
      >
        [{gettext("clear filter")} ×]
      </.link>
    </div>

    <div class="mt-16 flex flex-wrap items-end justify-between gap-4 border-b border-[color:var(--line)] pb-4">
      <div>
        <p class="term-prompt text-[0.72rem] t-faint">ls -lat posts/</p>
        <h2 class="mt-3 text-xl font-bold tracking-tight t-strong sm:text-2xl">
          {gettext("Latest posts")}
        </h2>
        <p :if={is_nil(@filter)} class="mt-2 text-[0.75rem] leading-6 t-faint">
          <span aria-hidden="true">// </span>{gettext(
            "Notes written while building all of the above."
          )}
        </p>
      </div>
      <span class="term-chip">
        {ngettext("%{count} file", "%{count} files", length(@articles))}
      </span>
    </div>

    <div id="articles" class="mt-6 space-y-6">
      <div :if={@articles == []} id="articles-empty" class="term-window overflow-hidden">
        <div class="term-bar">
          <span class="term-dots" aria-hidden="true">
            <span class="term-dot"></span>
            <span class="term-dot"></span>
            <span class="term-dot"></span>
          </span>
          <span class="term-title">stderr</span>
        </div>
        <div class="term-body py-12 text-center">
          <p class="term-prompt text-[0.78rem] t-dim">ls posts/</p>
          <p class="mt-3 text-[0.85rem] t-strong">
            {gettext("ls: no matching file for this selection")}
          </p>
          <p class="mx-auto mt-3 max-w-md text-[0.78rem] leading-6 t-faint">
            <span aria-hidden="true">// </span>{gettext(
              "The next piece is already in the works. Come back soon, or subscribe to the feed."
            )}
          </p>
          <p class="mt-5 text-[0.72rem] t-faint">exit status 1</p>
        </div>
      </div>

      <.article_card :if={@featured} article={@featured} featured />

      <div :if={@remaining != []} class="grid gap-6 md:grid-cols-2">
        <.article_card :for={article <- @remaining} article={article} />
      </div>
    </div>
  </section>
</Layouts.app>

<Layouts.app
  flash={@flash}
  current_language={@current_language}
  supported_languages={@supported_languages}
>
  <section
    id="not-found"
    class="mx-auto flex min-h-[62vh] max-w-3xl items-center px-4 py-16 sm:px-6"
  >
    <div class="term-window w-full overflow-hidden">
      <div class="term-bar">
        <span class="term-dots" aria-hidden="true">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
        </span>
        <span class="term-title">ex_blog — zsh</span>
        <span class="ml-auto flex-none t-faint">404</span>
      </div>

      <div class="term-body p-5 sm:p-9">
        <p class="term-prompt text-[0.8rem] t-dim">cat requested-page.md</p>
        <p class="mt-2 text-[0.8rem] t-body">
          cat: requested-page.md: No such file or directory
        </p>

        <h1 class="mt-8 text-3xl font-bold leading-tight tracking-tight t-strong sm:text-5xl">
          404 <span class="t-invert px-2">{gettext("not found")}</span>
        </h1>
        <p class="mt-5 max-w-xl text-[0.85rem] leading-7 t-dim">
          <span class="t-faint" aria-hidden="true">// </span>{gettext(
            "The content you were looking for does not exist, is not published yet or has moved."
          )}
        </p>

        <p class="term-prompt mt-9 text-[0.8rem] t-dim">cd ~/{@current_language}</p>
        <div class="mt-4">
          <.link href={~p"/#{@current_language}"} class="term-btn term-btn--primary">
            {gettext("Back to the articles")} <span aria-hidden="true">→</span>
          </.link>
        </div>

        <p class="mt-8 border-t border-dashed border-[color:var(--line)] pt-4 text-[0.7rem] t-faint">
          exit status 404
        </p>
      </div>
    </div>
  </section>
</Layouts.app>

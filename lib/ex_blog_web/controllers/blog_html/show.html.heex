<Layouts.app
  flash={@flash}
  current_language={@current_language}
  supported_languages={@supported_languages}
>
  <article id={"article-#{@article.lang}-#{@article.slug}"} class="pb-20">
    <div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6 lg:px-8">
      <nav
        id="article-breadcrumbs"
        aria-label="Breadcrumb"
        class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[0.72rem] t-faint"
      >
        <span class="t-faint" aria-hidden="true">$ cd</span>
        <.link href={~p"/#{@article.lang}"} class="transition hover:t-strong">
          ~/{@article.lang}
        </.link>
        <span aria-hidden="true">/</span>
        <.link
          :if={@article.category}
          href={~p"/category/#{@article.category}?lang=#{@article.lang}"}
          class="transition hover:t-strong"
        >
          {@article.category}
        </.link>
      </nav>

      <div class="term-window mt-4 overflow-hidden">
        <div class="term-bar">
          <span class="term-dots" aria-hidden="true">
            <span class="term-dot"></span>
            <span class="term-dot"></span>
            <span class="term-dot"></span>
          </span>
          <span class="term-title">{file_path(@article)}</span>
          <span class="ml-auto flex-none t-faint">
            <time datetime={date_string(@article.date)}>{format_date(@article.date)}</time>
          </span>
        </div>

        <div class="term-body p-5 sm:p-9">
          <p class="term-prompt text-[0.72rem] t-dim">
            cat {file_path(@article)} | head -1
          </p>
          <h1
            id="article-title"
            class="mt-4 max-w-4xl text-2xl font-bold leading-[1.15] tracking-tight text-balance t-strong sm:text-4xl lg:text-5xl"
          >
            {@article.title}
          </h1>
          <p
            :if={@article.seo_description || @article.excerpt}
            class="mt-5 max-w-3xl text-[0.85rem] leading-7 t-dim sm:text-[0.92rem]"
          >
            <span class="t-faint" aria-hidden="true">// </span>{@article.seo_description ||
              @article.excerpt}
          </p>

          <dl class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-dashed border-[color:var(--line)] pt-5 text-[0.7rem] t-faint">
            <div class="flex items-center gap-2">
              <dt class="sr-only">{gettext("Published")}</dt>
              <dd>
                <time datetime={date_string(@article.date)}>{format_date(@article.date)}</time>
              </dd>
            </div>
            <span aria-hidden="true">·</span>
            <div class="flex items-center gap-2">
              <dt class="sr-only">{gettext("Reading time")}</dt>
              <dd>{gettext("%{count} min", count: reading_time(@article.body))}</dd>
            </div>
            <span aria-hidden="true">·</span>
            <div class="flex items-center gap-2">
              <dt class="sr-only">{gettext("Words")}</dt>
              <dd>{gettext("%{count} words", count: word_count(@article.body))}</dd>
            </div>
            <span aria-hidden="true">·</span>
            <div class="flex items-center gap-2">
              <dt class="sr-only">{gettext("Language")}</dt>
              <dd class="t-dim">{@article.lang}</dd>
            </div>
            <span :if={@article.category} aria-hidden="true">·</span>
            <div :if={@article.category} class="flex items-center gap-2">
              <dt class="sr-only">{gettext("Category")}</dt>
              <dd class="t-dim">#{@article.category}</dd>
            </div>
          </dl>
        </div>
      </div>

      <figure
        :if={cover_source(@article.cover)}
        id="article-cover"
        class="term-window mt-6 overflow-hidden"
      >
        <div class="term-bar">
          <span class="term-dots" aria-hidden="true">
            <span class="term-dot"></span>
            <span class="term-dot"></span>
            <span class="term-dot"></span>
          </span>
          <span class="term-title">cover.png</span>
          <span class="ml-auto flex-none t-faint">1536×768</span>
        </div>
        <img
          id="article-cover-image"
          src={cover_source(@article.cover)}
          alt={cover_alt(@article)}
          class="term-media aspect-[16/8] w-full object-cover"
          width="1536"
          height="768"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </figure>
    </div>

    <div class="mx-auto grid max-w-6xl gap-10 px-4 pt-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_15rem] lg:px-8">
      <div id="article-body" class="article-prose min-w-0">
        {raw(@article.html)}
      </div>

      <aside class="space-y-5 lg:sticky lg:top-20 lg:self-start">
        <section
          :if={@translations != []}
          id="article-translations"
          class="term-window overflow-hidden"
        >
          <div class="term-bar">
            <span class="term-title">$ ls langs/</span>
          </div>
          <div class="term-body flex flex-wrap gap-2 py-4">
            <.link
              :for={translation <- @translations}
              href={~p"/#{translation.lang}/#{translation.slug}"}
              hreflang={translation.lang}
              class={[
                "term-chip",
                translation.lang == @article.lang && "term-chip--active"
              ]}
            >
              {translation.lang}
            </.link>
          </div>
        </section>

        <section :if={@article.tags != []} id="article-tags" class="term-window overflow-hidden">
          <div class="term-bar">
            <span class="term-title">$ cat tags.txt</span>
          </div>
          <div class="term-body flex flex-wrap gap-2 py-4">
            <.link
              :for={tag <- @article.tags}
              href={~p"/tag/#{tag}?lang=#{@article.lang}"}
              class="term-chip relative z-10"
            >
              #{tag}
            </.link>
          </div>
        </section>

        <section class="term-window overflow-hidden">
          <div class="term-bar">
            <span class="term-title">$ stat</span>
          </div>
          <dl class="term-body space-y-2 py-4 text-[0.68rem] leading-5">
            <div class="flex gap-3">
              <dt class="w-16 shrink-0 t-faint">slug</dt>
              <dd class="min-w-0 break-all t-dim">{@article.slug}</dd>
            </div>
            <div class="flex gap-3">
              <dt class="w-16 shrink-0 t-faint">updated</dt>
              <dd class="t-dim">{format_date(@article.updated || @article.date)}</dd>
            </div>
            <div class="flex gap-3">
              <dt class="w-16 shrink-0 t-faint">format</dt>
              <dd class="t-dim">markdown</dd>
            </div>
          </dl>
        </section>
      </aside>
    </div>

    <section
      :if={@related != []}
      id="related-articles"
      class="mx-auto mt-20 max-w-6xl border-t border-[color:var(--line)] px-4 pt-10 sm:px-6 lg:px-8"
    >
      <p class="term-prompt text-[0.72rem] t-faint">
        ls related/ --category={@article.category || "all"}
      </p>
      <h2 class="mt-3 text-xl font-bold tracking-tight t-strong">{gettext("Keep reading")}</h2>

      <div class="mt-6 grid gap-5 md:grid-cols-3">
        <.link
          :for={related <- @related}
          id={"related-#{related.lang}-#{related.slug}"}
          href={~p"/#{related.lang}/#{related.slug}"}
          class="term-window term-window--link group block overflow-hidden"
        >
          <div class="term-bar">
            <span class="term-dots" aria-hidden="true">
              <span class="term-dot"></span>
              <span class="term-dot"></span>
              <span class="term-dot"></span>
            </span>
            <span class="term-title">{related.slug}.md</span>
          </div>
          <div class="term-body py-4">
            <time datetime={date_string(related.date)} class="text-[0.68rem] t-faint">
              {format_date(related.date)}
            </time>
            <h3 class="mt-2 text-[0.92rem] font-bold leading-snug t-strong group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4">
              {related.title}
            </h3>
            <p class="mt-3 text-[0.68rem] t-faint">
              {gettext("open")}
              <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
            </p>
          </div>
        </.link>
      </div>
    </section>
  </article>
</Layouts.app>

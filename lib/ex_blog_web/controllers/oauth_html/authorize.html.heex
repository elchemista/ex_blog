<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_language={@current_language}
  supported_languages={@supported_languages}
>
  <section
    id="chatgpt-oauth-consent"
    class="mx-auto flex min-h-[calc(100vh-8rem)] max-w-2xl items-center px-4 py-14 sm:px-6"
  >
    <div class="term-window w-full overflow-hidden">
      <div class="term-bar">
        <span class="term-dots" aria-hidden="true">
          <span class="term-dot"></span>
          <span class="term-dot"></span>
          <span class="term-dot"></span>
        </span>
        <span class="term-title">oauth — authorize</span>
        <span class="ml-auto flex-none t-faint">mcp</span>
      </div>

      <div class="term-body p-5 sm:p-8">
        <p class="term-prompt text-[0.75rem] t-dim">
          ex_blog oauth grant --client "{@request.client_name}"
        </p>
        <h1 id="oauth-consent-heading" class="mt-4 text-xl font-bold tracking-tight t-strong">
          {gettext("Authorize %{client}", client: @request.client_name)}
        </h1>
        <p class="mt-2 text-[0.78rem] leading-6 t-faint">
          <span aria-hidden="true">// </span>{gettext(
            "You are connecting the ExBlog administrator to the MCP client. Review the permissions before continuing."
          )}
        </p>

        <div class="mt-7 border border-[color:var(--line)] bg-[color:var(--surface)]">
          <p class="border-b border-[color:var(--line)] bg-[color:var(--surface-bar)] px-4 py-2 text-[0.68rem] uppercase tracking-[0.16em] t-dim">
            {gettext("requested scopes")}
          </p>
          <ul id="oauth-requested-scopes" class="space-y-2 px-4 py-4">
            <li
              :for={scope <- @request.scopes}
              class="flex items-start gap-3 text-[0.78rem] leading-6 t-body"
            >
              <span class="t-faint" aria-hidden="true">[✓]</span>
              <span>{scope_label(scope)}</span>
            </li>
          </ul>
        </div>

        <p class="mt-5 border-l-2 border-[color:var(--line-strong)] pl-4 text-[0.72rem] leading-5 t-faint">
          {gettext(
            "Plaintext tokens are handed to the client only once. ExBlog stores nothing but revocable hashes and expiry dates on the persistent volume."
          )}
        </p>

        <.form
          for={@form}
          id="chatgpt-oauth-consent-form"
          action={~p"/oauth/authorize"}
          method="post"
          class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
        >
          <input
            :for={{key, value} <- @form.params}
            type="hidden"
            name={"oauth[#{key}]"}
            value={value}
          />
          <button
            id="oauth-deny-button"
            type="submit"
            name="oauth[decision]"
            value="deny"
            class="term-btn"
          >
            {gettext("Deny")}
          </button>
          <button
            id="oauth-approve-button"
            type="submit"
            name="oauth[decision]"
            value="approve"
            class="term-btn term-btn--primary"
          >
            {gettext("Authorize")} <span aria-hidden="true">→</span>
          </button>
        </.form>
      </div>
    </div>
  </section>
</Layouts.app>

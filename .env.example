# Phoenix (required in production; safe development placeholders shown here)
PHX_HOST=localhost
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret
PHX_SERVER=true
# Production examples; use exact comma-separated origins without a trailing slash.
# PHX_HOST=spectre.guide
# PHX_CHECK_ORIGINS=https://spectre.guide,https://spectre-blog.fly.dev
# EX_BLOG_CORS_ORIGINS=https://spectre.guide,https://spectre-blog.fly.dev

# Protected web administrator area. Generate the value locally with:
# mix ex_blog.admin.hash_password 'your-long-password'
EX_BLOG_ADMIN_PASSWORD_HASH='replace-with-the-generated-argon2-hash'

# Sole Telegram administrator and the persistent ExGram TDLib session
EX_BLOG_ADMIN_TELEGRAM_USERNAME=elchemista
TG_API_ID=12345
TG_API_HASH=replace-with-telegram-api-hash
EX_BLOG_TELEGRAM_SESSION_ID=ex_blog
# Optional: reuse an existing reviewed build instead of compiling TDLib locally.
# EX_GRAM_BACKEND_BINARY=/absolute/path/to/tdlib-json-cli

# Content repository
EX_BLOG_GITHUB_TOKEN=github_pat_replace_me
EX_BLOG_GITHUB_REPOSITORY=elchemista/elchemista-blog
EX_BLOG_GITHUB_BRANCH=main
EX_BLOG_GITHUB_AUTHOR_NAME="ExBlog Agent"
EX_BLOG_GITHUB_AUTHOR_EMAIL=ex-blog@users.noreply.github.com

# OpenRouter and runtime model routing
OPENROUTER_API_KEY=sk-or-replace-me
EX_BLOG_LLM_FAST_MODEL=meta-llama/llama-3.1-8b-instruct
EX_BLOG_LLM_BALANCED_MODEL=z-ai/glm-5.3-flash
EX_BLOG_LLM_DEEP_MODEL=openai/gpt-5.6-luna
EX_BLOG_CLASSIFIER_MODEL=meta-llama/llama-3.1-8b-instruct
EX_BLOG_EMBEDDING_MODEL=openrouter:perplexity/pplx-embed-v1-0.6b
EX_BLOG_EMBEDDING_DIMENSIONS=1024

# Optional routing dataset override. Production reads the checked-in release
# dataset and uses the OpenRouter embedding model configured above.
# SPECTRE_CLASSIFIER_DATASET_PATH=/absolute/path/to/dataset.json

# Development/test-only local classifier controls. Production rejects these
# native 384-dimensional artifacts and never includes ExFastembed.
# SPECTRE_CLASSIFIER_ARTIFACT_DIR=/absolute/path/to/classifier
# SPECTRE_LOCAL_CLASSIFIER=true

# Optional when Lightpanda is outside PATH and ~/.local/bin
# LIGHTPANDA_PATH=/absolute/path/to/lightpanda

# Optional public HTTPS origin for a development tunnel; production uses PHX_HOST
# EX_BLOG_CHATGPT_PUBLIC_BASE_URL=https://your-tunnel.example

# Direct operator MCP credential. ChatGPT uses OAuth instead.
EX_BLOG_MCP_TOKEN=replace-with-a-long-random-token

# Spectre Studio over Spectre Pulse. Leave EX_BLOG_PULSE_TOKEN unset to keep the
# connection off entirely: /pulse then refuses every upgrade. Generate one with
# `mix ex_blog.pulse.token` and paste the same value into Studio's connection
# form, whose endpoint is wss://<PHX_HOST>/pulse/websocket
# (ws://localhost:4000/pulse/websocket in development).
# EX_BLOG_PULSE_TOKEN=replace-with-mix-ex-blog-pulse-token
# Optional narrowing. Defaults to all seven supported scopes; Studio hides the
# panel behind any scope it is not granted.
# EX_BLOG_PULSE_SCOPES=agent.runtime.read,agent.runtime.stream,agent.operations.read,agent.operations.stream,agent.semantic_cache.read,agent.semantic_cache.promote,spectre.morph.propose

# Editorial defaults and guardrails
# The default language is served at `/`, which is the URL that accumulates search
# authority, so it matches the audience the site competes for. Other languages
# stay under their own prefix (`/it`).
EX_BLOG_DEFAULT_LANGUAGE=en
EX_BLOG_SUPPORTED_LANGUAGES=en,it
EX_BLOG_MONTHLY_BUDGET_EUR=20
EX_BLOG_MAX_ARTICLE_COST_EUR=2
EX_BLOG_USD_EUR_RATE=0.92

# Local development should override the production /data default
EX_BLOG_DATA_DIR="${PWD}/data"
EX_BLOG_CONTENT_ROOT=content
EX_BLOG_GIT_SYNC_INTERVAL_MS=900000

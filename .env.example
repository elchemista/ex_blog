# Phoenix (required in production; safe development placeholders shown here)
PHX_HOST=localhost
SECRET_KEY_BASE=replace-with-mix-phx-gen-secret
PHX_SERVER=true

# Protected web administrator area. Generate the value locally with:
# mix ex_blog.admin.hash_password 'your-long-password'
EX_BLOG_ADMIN_PASSWORD_HASH='replace-with-the-generated-argon2-hash'

# Sole Telegram administrator and the persistent ExGram TDLib session
EX_BLOG_ADMIN_TELEGRAM_ID=123456789
EX_BLOG_ADMIN_TELEGRAM_USERNAME=elchemista
EX_BLOG_TELEGRAM_API_ID=12345
EX_BLOG_TELEGRAM_API_HASH=replace-with-telegram-api-hash
EX_BLOG_TELEGRAM_SESSION_ID=ex_blog

# Content repository
EX_BLOG_GITHUB_TOKEN=github_pat_replace_me
EX_BLOG_GITHUB_REPOSITORY=elchemista/elchemista-blog
EX_BLOG_GITHUB_BRANCH=main
EX_BLOG_GITHUB_AUTHOR_NAME="ExBlog Agent"
EX_BLOG_GITHUB_AUTHOR_EMAIL=ex-blog@users.noreply.github.com

# OpenRouter and runtime model routing
OPENROUTER_API_KEY=sk-or-replace-me
EX_BLOG_LLM_FAST_MODEL=openai/gpt-5.6-luna
EX_BLOG_LLM_BALANCED_MODEL=openai/gpt-5.6-terra
EX_BLOG_LLM_DEEP_MODEL=openai/gpt-5.6-sol
EX_BLOG_CLASSIFIER_MODEL=openai/gpt-5.6-luna

# Optional when Lightpanda is outside PATH and ~/.local/bin
# LIGHTPANDA_PATH=/absolute/path/to/lightpanda

# Optional public HTTPS origin for a development tunnel; production uses PHX_HOST
# EX_BLOG_CHATGPT_PUBLIC_BASE_URL=https://your-tunnel.example

# Direct operator MCP credential. ChatGPT uses OAuth instead.
EX_BLOG_MCP_TOKEN=replace-with-a-long-random-token

# Editorial defaults and guardrails
EX_BLOG_DEFAULT_LANGUAGE=it
EX_BLOG_SUPPORTED_LANGUAGES=it,en
EX_BLOG_MONTHLY_BUDGET_EUR=20
EX_BLOG_MAX_ARTICLE_COST_EUR=2
EX_BLOG_USD_EUR_RATE=0.92

# Local development should override the production /data default
EX_BLOG_DATA_DIR="${PWD}/data"
EX_BLOG_CONTENT_ROOT=content
EX_BLOG_GIT_SYNC_INTERVAL_MS=900000
